{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "User project storing video analysis, scenes, characters, and story/thumbnail data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "videoFileName": { "type": "string" }
      },
      "required": ["id", "ownerUid", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}/projects/{projectId}": {
      "schema": "Project",
      "description": "User specific projects collection"
    }
  }
}
